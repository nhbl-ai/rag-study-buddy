# Runtime settings are in rag.toml. Keep provider credentials in your local .env.

# Gemini (optional if another provider is configured).
GEMINI_API_KEY=

# Groq Chat Completions with strict structured outputs.
GROQ_API_KEY=

# Cloudflare Workers AI REST API with a Workers AI API token and Account ID.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
