# Answer generation priority. Only providers with a key are used.
RAG_PROVIDER_ORDER=gemini,groq,cloudflare

# Gemini (optional if another provider is configured).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
# Process-local quota allowance, shared across browser sessions.
GEMINI_REQUESTS_PER_MINUTE=12
GEMINI_QUOTA_GROUP=default-project

# Groq Chat Completions with strict structured outputs.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60

# Cloudflare Workers AI REST API with a Workers AI API token and Account ID.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_TIMEOUT_SECONDS=60

# Local embeddings only; no local chat model is required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
OLLAMA_TIMEOUT_SECONDS=180
# Blank = automatic, 0 = CPU only.
# OLLAMA_EMBEDDING_GPU_LAYERS=0
