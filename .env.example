# Gemini answer generation: one attempt, no automatic retry/repair.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
# Process-local quota allowance, shared across browser sessions.
GEMINI_REQUESTS_PER_MINUTE=12
GEMINI_QUOTA_GROUP=default-project

# Local embeddings only; no local chat model is required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
OLLAMA_TIMEOUT_SECONDS=180
# Blank = automatic, 0 = CPU only.
# OLLAMA_EMBEDDING_GPU_LAYERS=0
