# Local Ollama models; no API key is required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=180

# Optional layer placement; blank = automatic, 0 = CPU only.
# Positive values request GPU layers on the server's selected device.
# OLLAMA_CHAT_GPU_LAYERS=8
# OLLAMA_EMBEDDING_GPU_LAYERS=0
